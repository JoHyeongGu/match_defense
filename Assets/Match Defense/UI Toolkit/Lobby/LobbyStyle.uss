:root {
}

.clay-text {
    -unity-font-definition: resource("Hakgyoansim Dunggeunmiso TTF B");
    -unity-font-style: normal;
    -unity-text-outline-width: 0.1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.361);
    text-shadow: 0 0 10px rgb(0, 0, 0);
    color: rgb(233, 202, 171);
}

.play-btn {
    position: absolute;
    align-self: center;
    align-content: center;
    transition-timing-function: ease-in-out-sine;
    transition-duration: 0.2s;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: rgb(226, 76, 52);
    width: auto;
    padding-top: 5%;
    padding-right: 5%;
    padding-bottom: 5%;
    padding-left: 5%;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    color: rgb(255, 201, 170);
    border-top-left-radius: 0%;
    border-top-right-radius: 0%;
    border-bottom-right-radius: 0%;
    border-bottom-left-radius: 0%;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    aspect-ratio: 1;
    background-image: url("project://database/Assets/Match%20Defense/Sprites/Lobby/Clay_Button.png?fileID=1235389772&guid=930688b933a58884b84696eacc44a6a8&type=3#Clay_Button_0");
    height: 13%;
    bottom: 20%;
}

.play-btn .unity-image {
    -unity-background-image-tint-color: rgb(253, 211, 187);
    background-image: url("project://database/Assets/Match%20Defense/Sprites/Lobby/Clay_Button.png?fileID=1358254642&guid=930688b933a58884b84696eacc44a6a8&type=3#Clay_Button_2");
    height: 90%;
    width: 80%;
    align-self: center;
    margin-left: 10%;
    transition-duration: 0.1s;
    transition-timing-function: ease-in;
    margin-top: 5%;
}

.play-btn:active .unity-image {
    -unity-background-image-tint-color: rgb(253, 211, 187);
    background-image: url("project://database/Assets/Match%20Defense/Sprites/Lobby/Clay_Button.png?fileID=210875437&guid=930688b933a58884b84696eacc44a6a8&type=3#Clay_Button_3");
    height: 80%;
    width: 75%;
    align-self: center;
    margin-left: 10%;
    margin-top: 5%;
}

.play-btn:active {
    -unity-background-image-tint-color: rgb(220, 70, 48);
    background-image: url("project://database/Assets/Match%20Defense/Sprites/Lobby/Clay_Button.png?fileID=-1174686892&guid=930688b933a58884b84696eacc44a6a8&type=3#Clay_Button_1");
}

.play-btn.hide {
    bottom: -20%;
    background-color: rgba(1, 1, 1, 0);
    border-left-color: rgba(1, 1, 1, 0);
    border-right-color: rgba(1, 1, 1, 0);
    border-top-color: rgba(1, 1, 1, 0);
    border-bottom-color: rgba(1, 1, 1, 0);
}

.bottom-tabs {
    flex-direction: row;
    margin-top: 0%;
    margin-right: 0%;
    margin-bottom: 0%;
    margin-left: 0%;
    height: 15%;
    position: absolute;
    top: auto;
    width: 100%;
    left: auto;
    bottom: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    align-items: stretch;
    transition-timing-function: ease-in-out-sine;
    transition-duration: 0.1s;
}

.page {
    position: absolute;
    width: 100%;
    height: 100%;
    left: 0;
    top: 0;
    translate: 100% 0;
    opacity: 1;
    display: none;
    transition-property: translate, opacity;
    transition-duration: 0.35s;
    transition-timing-function: ease-out-cubic;
}

.page--active {
    translate: 0 0;
    opacity: 1;
}

.page-tab-btn {
    flex-grow: 1;
    margin-right: 0;
    margin-left: 0;
    margin-bottom: 0;
    margin-top: 0;
    width: 25%;
    padding-left: 2%;
    padding-right: 2%;
    padding-bottom: 3%;
    border-top-left-radius: 10%;
    border-top-right-radius: 10%;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    -unity-text-align: lower-center;
    font-size: 13px;
    justify-content: space-between;
    align-items: center;
    flex-direction: column;
    padding-top: 2%;
    align-content: stretch;
    -unity-text-auto-size: best-fit 10px 100px;
    transition-property: background-color, border-color;
    transition-duration: 0.1s;
    transition-timing-function: ease-in-out;
    -unity-font-style: bold;
    -unity-font-definition: resource("Hakgyoansim Dunggeunmiso TTF R");
}

.page-tab-btn .unity-button__image {
    margin-bottom: 10%;
}

.page-tab-btn_stage {
    background-color: rgb(102, 57, 33);
    border-right-color: rgb(152, 93, 52);
    border-top-color: rgb(152, 93, 52);
    border-bottom-color: rgb(152, 93, 52);
    border-left-color: rgb(152, 93, 52);
}

.page-tab-btn_stage:active {
    background-color: rgb(85, 45, 25);
    border-left-color: rgb(135, 80, 45);
    border-right-color: rgb(135, 80, 45);
    border-top-color: rgb(135, 80, 45);
    border-bottom-color: rgb(135, 80, 45);
}

.page-tab-btn_store {
    border-left-color: rgb(188, 160, 81);
    border-right-color: rgb(188, 160, 81);
    border-top-color: rgb(188, 160, 81);
    border-bottom-color: rgb(188, 160, 81);
    background-color: rgb(185, 136, 48);
}

.page-tab-btn_store:active {
    background-color: rgb(160, 114, 36);
    border-left-color: rgb(166, 139, 66);
    border-right-color: rgb(166, 139, 66);
    border-top-color: rgb(166, 139, 66);
    border-bottom-color: rgb(166, 139, 66);
}

.page-tab-btn_inven {
    background-color: rgb(175, 109, 44);
    border-left-color: rgb(194, 133, 59);
    border-right-color: rgb(194, 133, 59);
    border-top-color: rgb(194, 133, 59);
    border-bottom-color: rgb(194, 133, 59);
}

.page-tab-btn_inven:active {
    background-color: rgb(151, 89, 32);
    border-left-color: rgb(170, 112, 45);
    border-right-color: rgb(170, 112, 45);
    border-top-color: rgb(170, 112, 45);
    border-bottom-color: rgb(170, 112, 45);
}

.page-tab-btn_quest {
    background-color: rgb(159, 85, 46);
    border-left-color: rgb(123, 72, 38);
    border-right-color: rgb(123, 72, 38);
    border-top-color: rgb(123, 72, 38);
    border-bottom-color: rgb(123, 72, 38);
}

.page-tab-btn_quest:active {
    background-color: rgb(137, 69, 36);
    border-left-color: rgb(108, 60, 31);
    border-right-color: rgb(108, 60, 31);
    border-top-color: rgb(108, 60, 31);
    border-bottom-color: rgb(108, 60, 31);
}
