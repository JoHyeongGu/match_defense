<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Match%20Defense/UI%20Toolkit/Lobby/LobbyStyle.uss?fileID=7433441132597879392&amp;guid=dd96823b66f7fca43987b4793a5e6ad8&amp;type=3#LobbyStyle"/>
    <ui:VisualElement name="root" style="flex-grow: 1;">
        <ui:Button text="PLAY" name="play-btn" class="play-btn"/>
        <ui:VisualElement name="pages" picking-mode="Ignore" style="flex-grow: 1; position: absolute; width: 100%; height: 100%;"/>
        <ui:VisualElement name="top" style="flex-direction: row; height: 15%; position: absolute; top: 0; width: 100%; margin-top: 0; padding-top: 15px;">
            <ui:VisualElement name="info" style="flex-grow: 1; background-color: rgb(190, 190, 190); flex-shrink: 0; border-top-right-radius: 15px; border-bottom-right-radius: 15px; padding-top: 1%; padding-bottom: 1%; padding-right: 3%; padding-left: 2%; justify-content: space-around; height: 60%;">
                <ui:VisualElement name="coin-status" style="background-color: rgb(255, 255, 255); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; flex-direction: row;">
                    <ui:Image name="coin-icon" style="height: 20px; width: 20px; background-color: rgb(255, 173, 0); border-top-left-radius: 100%; border-top-right-radius: 100%; border-bottom-right-radius: 100%; border-bottom-left-radius: 100%; border-top-width: 3px; border-right-width: 3px; border-bottom-width: 3px; border-left-width: 3px; border-left-color: rgba(0, 0, 0, 0.263); border-right-color: rgba(0, 0, 0, 0.263); border-top-color: rgba(0, 0, 0, 0.263); border-bottom-color: rgba(0, 0, 0, 0.263);">
                        <ui:Label text="$" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; justify-content: center; align-self: center; align-content: center; color: rgba(27, 27, 27, 0.212); -unity-font-style: bold; -unity-text-align: middle-center; text-shadow: 1px 0 0.4px rgba(0, 0, 0, 0.369);"/>
                    </ui:Image>
                    <ui:Label text="1,000" name="coin-label" style="flex-grow: 1; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 5px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; -unity-font-style: normal; -unity-text-align: middle-left; font-size: 12px; color: rgb(0, 0, 0);"/>
                </ui:VisualElement>
                <ui:VisualElement name="jewel-status" style="background-color: rgb(255, 255, 255); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; flex-direction: row;">
                    <ui:Image name="coin-icon" style="height: 20px; width: 20px; background-color: rgb(0, 243, 255); border-top-left-radius: 30%; border-top-right-radius: 30%; border-bottom-right-radius: 30%; border-bottom-left-radius: 30%; border-top-width: 3px; border-right-width: 3px; border-bottom-width: 3px; border-left-width: 3px; border-left-color: rgba(0, 0, 0, 0.263); border-right-color: rgba(0, 0, 0, 0.263); border-top-color: rgba(0, 0, 0, 0.263); border-bottom-color: rgba(0, 0, 0, 0.263);">
                        <ui:Label text="D" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; justify-content: center; align-self: center; align-content: center; color: rgba(27, 27, 27, 0.212); -unity-font-style: bold; -unity-text-align: middle-center; text-shadow: 1px 0 0.4px rgba(0, 0, 0, 0.369);"/>
                    </ui:Image>
                    <ui:Label text="300" style="flex-grow: 1; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 5px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; -unity-font-style: normal; -unity-text-align: middle-left; font-size: 12px; color: rgb(0, 0, 0);"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="top-left-menu" style="flex-grow: 5; flex-shrink: 0; padding-top: 0; padding-bottom: 0; justify-content: space-between;">
                <ui:Button name="setting-btn" text="Setting" style="width: 30%; height: 50%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; align-self: flex-end; border-top-left-radius: 15px; border-bottom-left-radius: 15px; flex-grow: 1; background-size: 100% 100px;"/>
                <ui:Button name="ranking-btn" text="Ranking" style="width: 30%; height: 50%; margin-top: 5px; margin-right: 0; margin-bottom: 0; margin-left: 0; align-self: flex-end; justify-content: flex-end; border-top-left-radius: 15px; border-bottom-left-radius: 15px; flex-grow: 1;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:ToggleButtonGroup label="" name="bottom" class="bottom-tabs">
            <ui:Button text="STAGE" name="stage-btn" style="flex-grow: 1; margin-right: 0; margin-left: 0; margin-bottom: 0; margin-top: 0; width: 25%; padding-top: 0; padding-left: 0; padding-right: 0; padding-bottom: 0; border-top-left-radius: 20px;"/>
            <ui:Button text="STORE" name="store-btn" style="flex-grow: 1; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; width: 25%; padding-top: 0; padding-left: 0; padding-right: 0; padding-bottom: 0;"/>
            <ui:Button text="INVENTORY" name="inventory-btn" style="flex-grow: 1; margin-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; width: 25%; padding-left: 0; padding-right: 0; padding-bottom: 0; padding-top: 0;"/>
            <ui:Button text="QUEST" name="quest-btn" style="flex-grow: 1; margin-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; width: 25%; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; border-top-right-radius: 20px;"/>
        </ui:ToggleButtonGroup>
    </ui:VisualElement>
</ui:UXML>
