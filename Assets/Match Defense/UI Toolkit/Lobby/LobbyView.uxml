<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Match%20Defense/UI%20Toolkit/Lobby/LobbyStyle.uss?fileID=7433441132597879392&amp;guid=dd96823b66f7fca43987b4793a5e6ad8&amp;type=3#LobbyStyle"/>
    <SafeArea style="flex-grow: 1; flex-shrink: 0;">
        <ui:VisualElement name="root" style="flex-grow: 1;">
            <ui:Button text="" name="skip-btn" enabled="false" style="position: absolute; height: 100%; width: 100%; top: 0%; left: 0%; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0);"/>
            <LocalizedLabel name="stage-title" localization-key="stage_1_title" text="Kitchen" font-size="16" outline-width-v-w="1" shadow-color="rgb(255, 168, 0)" shadow-blur-v-w="50" shadow-offset-v-w="0,-10" class="clay-text" style="position: absolute; top: 13%; align-self: center; width: 70%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; -unity-text-align: middle-center; -unity-text-outline-color: rgb(183, 111, 32); letter-spacing: -7px; -unity-font-style: bold;"/>
            <PageScroll name="sub-stage-scroll" style="position: absolute; width: 100%; height: 10%; top: 20%;">
                <StageSelect empty-star="project://database/Assets/Match%20Defense/Sprites/Lobby/Clay_Star.png?fileID=1968828789&amp;guid=1d4a53bac73772346b4713bf5106a78c&amp;type=3#Clay_Star_0" filled-star="project://database/Assets/Match%20Defense/Sprites/Lobby/Clay_Star.png?fileID=-1635362499&amp;guid=1d4a53bac73772346b4713bf5106a78c&amp;type=3#Clay_Star_1" name="stage-item" filled-color="rgb(255, 203, 0)" filled-count="4" text-color="rgb(219, 194, 170)" outline-width="2" custom-font="project://database/Assets/Match%20Defense/Fonts/Resources/Hakgyoansim%20Dunggeunmiso%20TTF%20B.ttf?fileID=12800000&amp;guid=cdcf285e52c2c414b9cdec11a70a5968&amp;type=3#Hakgyoansim Dunggeunmiso TTF B" sub-text="1. Keep your important things safe!" outline-color="rgba(183, 111, 32, 0)" localization-key="stage_sub_1"/>
                <StageSelect empty-star="project://database/Assets/Match%20Defense/Sprites/Lobby/Clay_Star.png?fileID=1968828789&amp;guid=1d4a53bac73772346b4713bf5106a78c&amp;type=3#Clay_Star_0" filled-star="project://database/Assets/Match%20Defense/Sprites/Lobby/Clay_Star.png?fileID=-1635362499&amp;guid=1d4a53bac73772346b4713bf5106a78c&amp;type=3#Clay_Star_1" name="stage-item" filled-color="rgb(255, 203, 0)" filled-count="5" text-color="rgb(219, 194, 170)" outline-width="2" custom-font="project://database/Assets/Match%20Defense/Fonts/Resources/Hakgyoansim%20Dunggeunmiso%20TTF%20B.ttf?fileID=12800000&amp;guid=cdcf285e52c2c414b9cdec11a70a5968&amp;type=3#Hakgyoansim Dunggeunmiso TTF B" sub-text="2. Sticky Power" outline-color="rgba(183, 111, 32, 0)" localization-key="stage_sub_2"/>
                <StageSelect empty-star="project://database/Assets/Match%20Defense/Sprites/Lobby/Clay_Star.png?fileID=1968828789&amp;guid=1d4a53bac73772346b4713bf5106a78c&amp;type=3#Clay_Star_0" filled-star="project://database/Assets/Match%20Defense/Sprites/Lobby/Clay_Star.png?fileID=-1635362499&amp;guid=1d4a53bac73772346b4713bf5106a78c&amp;type=3#Clay_Star_1" name="stage-item" filled-color="rgb(255, 203, 0)" filled-count="2" text-color="rgb(219, 194, 170)" outline-width="2" custom-font="project://database/Assets/Match%20Defense/Fonts/Resources/Hakgyoansim%20Dunggeunmiso%20TTF%20B.ttf?fileID=12800000&amp;guid=cdcf285e52c2c414b9cdec11a70a5968&amp;type=3#Hakgyoansim Dunggeunmiso TTF B" sub-text="3. Germ of Red Runner" outline-color="rgba(183, 111, 32, 0)" localization-key="stage_sub_3"/>
                <StageSelect empty-star="project://database/Assets/Match%20Defense/Sprites/Lobby/Clay_Star.png?fileID=1968828789&amp;guid=1d4a53bac73772346b4713bf5106a78c&amp;type=3#Clay_Star_0" filled-star="project://database/Assets/Match%20Defense/Sprites/Lobby/Clay_Star.png?fileID=-1635362499&amp;guid=1d4a53bac73772346b4713bf5106a78c&amp;type=3#Clay_Star_1" name="stage-item" filled-color="rgb(255, 203, 0)" filled-count="0" text-color="rgb(219, 194, 170)" outline-width="2" custom-font="project://database/Assets/Match%20Defense/Fonts/Resources/Hakgyoansim%20Dunggeunmiso%20TTF%20B.ttf?fileID=12800000&amp;guid=cdcf285e52c2c414b9cdec11a70a5968&amp;type=3#Hakgyoansim Dunggeunmiso TTF B" sub-text="4. A Tough Uninvited Guest " outline-color="rgba(183, 111, 32, 0)" localization-key="stage_sub_4"/>
                <StageSelect empty-star="project://database/Assets/Match%20Defense/Sprites/Lobby/Clay_Star.png?fileID=1968828789&amp;guid=1d4a53bac73772346b4713bf5106a78c&amp;type=3#Clay_Star_0" filled-star="project://database/Assets/Match%20Defense/Sprites/Lobby/Clay_Star.png?fileID=-1635362499&amp;guid=1d4a53bac73772346b4713bf5106a78c&amp;type=3#Clay_Star_1" name="stage-item" filled-color="rgb(255, 203, 0)" filled-count="0" text-color="rgb(219, 194, 170)" outline-width="2" custom-font="project://database/Assets/Match%20Defense/Fonts/Resources/Hakgyoansim%20Dunggeunmiso%20TTF%20B.ttf?fileID=12800000&amp;guid=cdcf285e52c2c414b9cdec11a70a5968&amp;type=3#Hakgyoansim Dunggeunmiso TTF B" sub-text="4. A Tough Uninvited Guest " outline-color="rgba(183, 111, 32, 0)" localization-key="stage_sub_5"/>
                <StageSelect empty-star="project://database/Assets/Match%20Defense/Sprites/Lobby/Clay_Star.png?fileID=1968828789&amp;guid=1d4a53bac73772346b4713bf5106a78c&amp;type=3#Clay_Star_0" filled-star="project://database/Assets/Match%20Defense/Sprites/Lobby/Clay_Star.png?fileID=-1635362499&amp;guid=1d4a53bac73772346b4713bf5106a78c&amp;type=3#Clay_Star_1" name="stage-item" filled-color="rgb(255, 203, 0)" filled-count="0" text-color="rgb(219, 194, 170)" outline-width="2" custom-font="project://database/Assets/Match%20Defense/Fonts/Resources/Hakgyoansim%20Dunggeunmiso%20TTF%20B.ttf?fileID=12800000&amp;guid=cdcf285e52c2c414b9cdec11a70a5968&amp;type=3#Hakgyoansim Dunggeunmiso TTF B" sub-text="4. A Tough Uninvited Guest " outline-color="rgba(183, 111, 32, 0)" localization-key="stage_sub_6"/>
            </PageScroll>
            <ui:Button name="play-btn" class="play-btn" style="bottom: 19%;">
                <ui:Image name="play-btn-icon"/>
            </ui:Button>
            <ui:VisualElement name="pages" picking-mode="Ignore" style="flex-grow: 1; position: absolute; width: 100%; height: 100%;"/>
            <ui:VisualElement name="top" style="flex-direction: row; height: 7%; position: absolute; top: 2%; width: 100%; margin-top: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;">
                <ui:VisualElement name="info" style="flex-grow: 1; background-color: rgb(190, 190, 190); flex-shrink: 0; border-top-right-radius: 15px; border-bottom-right-radius: 15px; padding-top: 1%; padding-bottom: 1%; padding-right: 3%; padding-left: 2%; justify-content: space-around; height: 100%;">
                    <ui:VisualElement name="coin-status" style="background-color: rgb(255, 255, 255); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; flex-direction: row;">
                        <ui:Image name="coin-icon" style="height: 20px; width: 20px; background-color: rgb(255, 173, 0); border-top-left-radius: 100%; border-top-right-radius: 100%; border-bottom-right-radius: 100%; border-bottom-left-radius: 100%; border-top-width: 3px; border-right-width: 3px; border-bottom-width: 3px; border-left-width: 3px; border-left-color: rgba(0, 0, 0, 0.263); border-right-color: rgba(0, 0, 0, 0.263); border-top-color: rgba(0, 0, 0, 0.263); border-bottom-color: rgba(0, 0, 0, 0.263);">
                            <ui:Label text="$" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; justify-content: center; align-self: center; align-content: center; color: rgba(27, 27, 27, 0.212); -unity-font-style: bold; -unity-text-align: middle-center; text-shadow: 1px 0 0.4px rgba(0, 0, 0, 0.369);"/>
                        </ui:Image>
                        <ui:Label text="1,000" name="coin-label" style="flex-grow: 1; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 5px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; -unity-font-style: normal; -unity-text-align: middle-left; font-size: 12px; color: rgb(0, 0, 0);"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="jewel-status" style="background-color: rgb(255, 255, 255); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; flex-direction: row;">
                        <ui:Image name="coin-icon" style="height: 20px; width: 20px; background-color: rgb(0, 243, 255); border-top-left-radius: 30%; border-top-right-radius: 30%; border-bottom-right-radius: 30%; border-bottom-left-radius: 30%; border-top-width: 3px; border-right-width: 3px; border-bottom-width: 3px; border-left-width: 3px; border-left-color: rgba(0, 0, 0, 0.263); border-right-color: rgba(0, 0, 0, 0.263); border-top-color: rgba(0, 0, 0, 0.263); border-bottom-color: rgba(0, 0, 0, 0.263);">
                            <ui:Label text="D" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; justify-content: center; align-self: center; align-content: center; color: rgba(27, 27, 27, 0.212); -unity-font-style: bold; -unity-text-align: middle-center; text-shadow: 1px 0 0.4px rgba(0, 0, 0, 0.369);"/>
                        </ui:Image>
                        <ui:Label text="300" style="flex-grow: 1; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 5px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; -unity-font-style: normal; -unity-text-align: middle-left; font-size: 12px; color: rgb(0, 0, 0);"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="top-left-menu" style="flex-grow: 5; flex-shrink: 0; padding-top: 0; padding-bottom: 0; justify-content: space-between;">
                    <LocalizedButton name="setting-btn" localization-key="setting" font-size="16" icon-image="project://database/Assets/Match%20Defense/Sprites/Lobby/Setting_Icon.png?fileID=21300000&amp;guid=6ebe28c6ae8db5e46b2cc9e543be8155&amp;type=3#Setting_Icon" style="align-self: flex-end; width: 32%; height: 50%; padding-top: 0; padding-right: 5%; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; border-top-left-radius: 15%; border-bottom-left-radius: 15%; -unity-font-definition: resource(&quot;Hakgyoansim Dunggeunmiso TTF R&quot;); -unity-font-style: bold;"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:ToggleButtonGroup label="" name="bottom" class="bottom-tabs">
                <LocalizedButton icon-image="project://database/Assets/Match%20Defense/Sprites/Lobby/Lobby_Tabs_Icons.png?fileID=1104462012&amp;guid=61dca54a4f5999844af85f59b79b7aac&amp;type=3#Lobby_Tabs_Icons_0" name="stage-btn" localization-key="stage" class="page-tab-btn clay-text page-tab-btn_stage"/>
                <LocalizedButton icon-image="project://database/Assets/Match%20Defense/Sprites/Lobby/Lobby_Tabs_Icons.png?fileID=-223385518&amp;guid=61dca54a4f5999844af85f59b79b7aac&amp;type=3#Lobby_Tabs_Icons_1" name="store-btn" localization-key="store" class="page-tab-btn clay-text page-tab-btn_store"/>
                <LocalizedButton icon-image="project://database/Assets/Match%20Defense/Sprites/Lobby/Lobby_Tabs_Icons.png?fileID=-495078262&amp;guid=61dca54a4f5999844af85f59b79b7aac&amp;type=3#Lobby_Tabs_Icons_2" name="inven-btn" localization-key="inventory" class="page-tab-btn clay-text page-tab-btn_inven"/>
                <LocalizedButton icon-image="project://database/Assets/Match%20Defense/Sprites/Lobby/Lobby_Tabs_Icons.png?fileID=510007784&amp;guid=61dca54a4f5999844af85f59b79b7aac&amp;type=3#Lobby_Tabs_Icons_3" name="quest-btn" localization-key="quest" class="page-tab-btn clay-text page-tab-btn_quest"/>
            </ui:ToggleButtonGroup>
        </ui:VisualElement>
    </SafeArea>
</ui:UXML>
