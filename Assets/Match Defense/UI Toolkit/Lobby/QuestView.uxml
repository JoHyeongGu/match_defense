<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="QuestStyle.uss" />
    <ui:VisualElement name="quest-panel" class="quest-page-root">
        <ui:VisualElement class="quest-container-card">
            <LocalizedLabel name="quest-title" localization-key="quest_page_title" text="QUESTS" font-size="0" class="quest-header-title" />
            <ui:ScrollView class="quest-scroll">
                <ui:VisualElement name="quest-list-container" class="quest-list-container" />
            </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
