.tutorial-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.tutorial-overlay.hide {
    display: none;
}

.tut-dim {
    position: absolute;
    background-color: rgba(12, 6, 2, 0.72);
}

.tut-spotlight-frame {
    position: absolute;
    border-width: 6px;
    border-color: rgb(255, 214, 72);
    border-radius: 26px;
    background-color: rgba(0, 0, 0, 0);
}

.tut-dialog-box {
    position: absolute;
    left: 5%;
    right: 5%;
    height: auto;
    flex-shrink: 0;
    overflow: visible;
    padding: 32px 30px;
    border-radius: 30px;
    background-color: rgb(112, 62, 28);
    border-width: 6px;
    border-color: rgb(255, 212, 102);
    flex-direction: column;
    align-items: center;
    filter: drop-shadow(0 10 20 rgba(0, 0, 0, 0.65));
}

.tut-dialog--top {
    top: 13%;
    bottom: auto;
}

.tut-dialog--center {
    top: 38%;
    bottom: auto;
}

.tut-dialog--bottom {
    top: auto;
    bottom: 12%;
}

.tut-dialog-text {
    width: 100%;
    height: auto;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    white-space: normal;
    -unity-font-definition: resource("Hakgyoansim Dunggeunmiso TTF R");
    -unity-text-align: middle-center;
    font-size: 34px;
    color: rgb(255, 246, 232);
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.55);
    -unity-font-style: bold;
}

.tut-tap-hint {
    margin-top: 16px;
    -unity-font-definition: resource("Hakgyoansim Dunggeunmiso TTF R");
    font-size: 26px;
    color: rgb(255, 216, 120);
}

.tut-skip-btn {
    position: absolute;
    top: 3.5%;
    right: 4%;
    width: 190px;
    height: 80px;
    border-width: 4px;
    border-color: rgb(255, 224, 152);
    border-radius: 22px;
    background-color: rgba(84, 44, 18, 0.92);
    -unity-font-definition: resource("Hakgyoansim Dunggeunmiso TTF B");
    -unity-text-align: middle-center;
    -unity-text-auto-size: best-fit 22px 38px;
    color: rgb(255, 244, 224);
}

.tut-skip-btn:active {
    scale: 0.94 0.94;
}
