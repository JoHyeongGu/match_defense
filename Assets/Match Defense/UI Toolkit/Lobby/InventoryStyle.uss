.inven-page-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(58, 38, 29);
}

.inven-content-wrap {
    position: absolute;
    top: 8%;
    bottom: 16.5%;
    left: 4%;
    right: 4%;
    flex-direction: column;
    justify-content: space-between;
}

.inven-section {
    width: 100%;
    padding: 2.2% 3%;
    border-radius: 28px;
    background-color: rgb(116, 66, 32);
    border-width: 5px;
    border-color: rgb(198, 138, 76);
}

.inven-equip-section {
    height: 22%;
    flex-shrink: 0;
    flex-direction: column;
    justify-content: space-between;
}

.inven-section-title {
    width: 100%;
    height: 28%;
    margin: 0;
    padding: 0;
    -unity-font-definition: resource("Hakgyoansim Dunggeunmiso TTF B");
    -unity-text-align: middle-left;
    -unity-text-auto-size: best-fit 22px 46px;
    color: rgb(255, 232, 186);
}

.inven-owned-title {
    height: 13%;
    margin-bottom: 1.5%;
}

.equip-slots-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 68%;
    width: 100%;
}

.inven-equip-slot {
    width: 18.6%;
    height: 100%;
    margin: 0;
    padding: 1.5%;
    border-radius: 20px;
    border-width: 4px;
    border-color: rgb(232, 174, 98);
    background-color: rgb(74, 40, 18);
    justify-content: center;
    align-items: center;
}

.inven-equip-slot--empty {
    border-color: rgba(232, 174, 98, 0.45);
    background-color: rgba(54, 28, 12, 0.65);
}

.inven-slot-icon,
.inven-card-icon {
    width: 78%;
    height: 68%;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}

.inven-slot-level {
    position: absolute;
    bottom: 4px;
    right: 8px;
    font-size: 26px;
    color: rgb(255, 238, 186);
    -unity-font-definition: resource("Hakgyoansim Dunggeunmiso TTF B");
    text-shadow: 2px 2px 3px rgba(0, 0, 0, 0.7);
}

.inven-slot-plus {
    font-size: 60px;
    color: rgba(255, 224, 178, 0.45);
    -unity-font-definition: resource("Hakgyoansim Dunggeunmiso TTF B");
}

.inven-detail-panel {
    width: 100%;
    height: 31%;
    flex-shrink: 0;
    margin-top: 1.5%;
    margin-bottom: 1.5%;
    padding: 2.5% 3.5%;
    border-radius: 28px;
    background-color: rgb(88, 48, 22);
    border-width: 5px;
    border-color: rgb(214, 148, 82);
    flex-direction: column;
    justify-content: space-between;
}

.detail-top-row {
    width: 100%;
    height: 62%;
    flex-direction: row;
    align-items: center;
}

.detail-unit-icon {
    height: 92%;
    width: auto;
    aspect-ratio: 1;
    margin-right: 4%;
    border-radius: 22px;
    background-color: rgb(62, 32, 14);
    border-width: 3px;
    border-color: rgb(186, 128, 66);
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}

.detail-info-col {
    flex-grow: 1;
    height: 100%;
    flex-direction: column;
    justify-content: space-around;
}

.detail-unit-name {
    width: 100%;
    height: 30%;
    margin: 0;
    padding: 0;
    -unity-font-definition: resource("Hakgyoansim Dunggeunmiso TTF B");
    -unity-text-align: middle-left;
    -unity-text-auto-size: best-fit 26px 48px;
    color: rgb(255, 244, 228);
}

.detail-unit-level,
.detail-unit-stats,
.detail-unit-stack {
    width: 100%;
    height: 22%;
    margin: 0;
    padding: 0;
    -unity-font-definition: resource("Hakgyoansim Dunggeunmiso TTF R");
    -unity-text-align: middle-left;
    -unity-text-auto-size: best-fit 20px 34px;
    color: rgb(242, 212, 176);
}

.detail-actions-row {
    width: 100%;
    height: 32%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.detail-btn {
    width: 48%;
    height: 100%;
    margin: 0;
    padding: 0 3%;
    border-width: 0;
    border-radius: 20px;
    -unity-font-definition: resource("Hakgyoansim Dunggeunmiso TTF B");
    -unity-text-align: middle-center;
    -unity-text-auto-size: best-fit 22px 42px;
    color: rgb(255, 248, 238);
}

.detail-btn--equip {
    background-color: rgb(72, 152, 82);
}

.detail-btn--upgrade {
    background-color: rgb(214, 134, 44);
}

.detail-btn:disabled {
    opacity: 0.45;
}

.inven-owned-section {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    flex-direction: column;
}

.owned-scroll {
    flex-grow: 1;
}

.owned-units-grid {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
}

.inven-unit-card {
    width: 23%;
    height: 220px;
    margin: 1%;
    padding: 10px 6px;
    border-radius: 22px;
    border-width: 4px;
    border-color: rgb(168, 114, 62);
    background-color: rgb(74, 40, 18);
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
}

.inven-unit-card--selected {
    border-width: 6px;
    border-color: rgb(255, 216, 78);
    background-color: rgb(104, 58, 26);
}

.inven-unit-card--equipped {
    border-color: rgb(108, 214, 118);
}

.inven-card-level {
    font-size: 26px;
    margin: 0;
    padding: 0;
    color: rgb(255, 240, 214);
    -unity-font-definition: resource("Hakgyoansim Dunggeunmiso TTF B");
}

.inven-card-stack {
    font-size: 24px;
    margin: 0;
    padding: 0;
    color: rgb(214, 186, 154);
    -unity-font-definition: resource("Hakgyoansim Dunggeunmiso TTF R");
}

.inven-card-stack--ready {
    color: rgb(120, 242, 128);
}

.inven-equipped-badge {
    position: absolute;
    top: 8px;
    left: 8px;
    padding: 3px 10px;
    border-radius: 10px;
    background-color: rgb(72, 168, 86);
    color: rgb(255, 255, 255);
    font-size: 22px;
    -unity-font-definition: resource("Hakgyoansim Dunggeunmiso TTF B");
}

.detail-stack-bar-bg {
    width: 100%;
    height: 28%;
    margin-top: 4px;
    border-radius: 14px;
    background-color: rgb(46, 24, 10);
    border-width: 3px;
    border-color: rgb(164, 108, 54);
    overflow: hidden;
    justify-content: center;
    align-items: center;
}

.detail-stack-bar-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0%;
    background-color: rgb(228, 154, 48);
    transition-property: width;
    transition-duration: 0.25s;
}

.detail-stack-bar-txt {
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    -unity-font-definition: resource("Hakgyoansim Dunggeunmiso TTF B");
    -unity-text-align: middle-center;
    -unity-text-auto-size: best-fit 18px 30px;
    color: rgb(255, 250, 240);
    text-shadow: 2px 2px 3px rgba(0, 0, 0, 0.75);
}

.inven-card-bar-bg {
    width: 92%;
    height: 34px;
    border-radius: 10px;
    background-color: rgb(42, 22, 10);
    border-width: 2px;
    border-color: rgb(146, 94, 48);
    overflow: hidden;
    justify-content: center;
    align-items: center;
}

.inven-card-bar-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0%;
    background-color: rgb(224, 152, 54);
}

.inven-bar-fill--ready {
    background-color: rgb(88, 206, 98);
}

.inven-card-bar-txt {
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    -unity-font-definition: resource("Hakgyoansim Dunggeunmiso TTF B");
    -unity-text-align: middle-center;
    font-size: 20px;
    color: rgb(255, 250, 240);
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
}
