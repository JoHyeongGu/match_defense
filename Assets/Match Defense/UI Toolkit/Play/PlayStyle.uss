.play-safe-area {
    width: 100%;
    height: 100%;
    flex-direction: column;
    justify-content: space-between;
}

.top-hud {
    width: 100%;
    height: 6.5%;
    padding: 1.5% 3% 0 3%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    flex-shrink: 0;
}

.hp-group {
    width: 40%;
    height: 76%;
    flex-direction: row;
    align-items: center;
    position: relative;
}

.hp-bar-bg {
    position: absolute;
    left: 11%;
    right: 0;
    height: 72%;
    background-color: rgb(118, 34, 30);
    border-width: 2px;
    border-color: rgb(88, 22, 18);
    overflow: hidden;
    justify-content: center;
    align-items: center;
    filter: drop-shadow(0 2 2 rgba(0, 0, 0, 0.35));
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-right-radius: 14px;
    border-bottom-left-radius: 14px;
    padding-top: 3%;
    padding-bottom: 3%;
}

.hp-bar-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    background-color: rgb(217, 67, 59);
    transition-property: width;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
}

.hp-text {
    width: 100%;
    height: 100%;
    padding-left: 18%;
    padding-right: 6%;
    padding-top: 0;
    padding-bottom: 0;
    margin: 0;
    -unity-font-definition: resource("Hakgyoansim Dunggeunmiso TTF B");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    -unity-text-auto-size: best-fit 8px 100px;
    color: rgb(255, 245, 238);
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.55);
}

.hp-heart {
    position: absolute;
    left: 0;
    height: 100%;
    width: auto;
    aspect-ratio: 1;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    filter: drop-shadow(0 2 2 rgba(0, 0, 0, 0.35));
    background-image: url("project://database/Assets/Match%20Defense/Sprites/Play/clay-icons.png?fileID=668806775&guid=3f4563c25d00ce842a6b7b5334d90d98&type=3#heart-icon");
    -unity-background-image-tint-color: rgb(255, 69, 69);
}

.top-right-group {
    width: 44%;
    height: 80%;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
}

.wave-box {
    flex-grow: 1;
    height: 100%;
    margin-right: 4%;
    padding: 4% 8%;
    justify-content: center;
    align-items: center;
    background-image: url("project://database/Assets/Match%20Defense/Sprites/UI/Clay_Rects.png?fileID=-981860313&guid=d8cd81cc99e6902459f2c392b35ef169&type=3#Clay_Rects_4");
    -unity-background-image-tint-color: rgb(154, 93, 49);
    -unity-slice-left: 7;
    -unity-slice-top: 7;
    -unity-slice-right: 7;
    -unity-slice-bottom: 7;
    filter: drop-shadow(0 2 2 rgba(0, 0, 0, 0.35));
}

.wave-text {
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    -unity-font-definition: resource("Hakgyoansim Dunggeunmiso TTF B");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    -unity-text-auto-size: best-fit 8px 100px;
    color: rgb(255, 245, 232);
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.45);
}

.pause-btn {
    height: 100%;
    width: auto;
    aspect-ratio: 1;
    flex-shrink: 0;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding: 0;
    margin: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Match%20Defense/Sprites/UI/Clay_Rects.png?fileID=-1111875157&guid=d8cd81cc99e6902459f2c392b35ef169&type=3#Clay_Rects_1");
    -unity-background-image-tint-color: rgb(154, 93, 49);
    -unity-slice-left: 7;
    -unity-slice-top: 7;
    -unity-slice-right: 7;
    -unity-slice-bottom: 7;
    transition-property: scale;
    transition-duration: 0.1s;
    filter: drop-shadow(0 2 2 rgba(0, 0, 0, 0.35));
}

.pause-btn:active {
    -unity-background-image-tint-color: rgb(122, 70, 34);
    scale: 0.94 0.94;
}

.pause-bar {
    width: 18%;
    height: 48%;
    margin-left: 7%;
    margin-right: 7%;
    background-color: rgb(255, 243, 228);
    border-radius: 4px;
}

.bottom-panel {
    width: 100%;
    height: 60%;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 1.5%;
}

.store-board {
    position: relative;
    width: 100%;
    height: 16%;
    flex-shrink: 0;
    flex-direction: row;
    justify-content: space-around;
    align-items: center;
    padding: 1.5% 2% 3% 2%;
    transition-property: translate;
    transition-duration: 0.5s;
    transition-timing-function: ease-in;
    background-image: url("project://database/Assets/Match%20Defense/Sprites/UI/Clay_Rects.png?fileID=-981860313&guid=d8cd81cc99e6902459f2c392b35ef169&type=3#Clay_Rects_4");
    -unity-background-image-tint-color: rgb(200, 128, 71);
    -unity-slice-left: 4;
    -unity-slice-right: 4;
    -unity-slice-top: 4;
    -unity-slice-bottom: 4;
}

.store-board.hide {
    bottom: 0%;
}

.store-frame {
    align-items: center;
    justify-content: center;
    background-image: url("project://database/Assets/Match%20Defense/Sprites/Play/Char_Frame_Clay.png?fileID=21300000&guid=94ebb3c3edf3b87469d7af73a22712b0&type=3#Char_Frame_Clay");
    -unity-background-image-tint-color: rgb(209, 125, 64);
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}

.store-thumb {
    position: absolute;
    top: 10%;
    width: 64%;
    height: 64%;
}

.store-slider {
    position: absolute;
    left: 18%;
    right: 19%;
    bottom: 4%;
    height: 28%;
}

.store-count {
    position: absolute;
    top: 4%;
    right: 7%;
    width: 32%;
    height: 32%;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
    color: rgba(255, 255, 255, 0.729);
    -unity-font-style: normal;
    -unity-font-definition: resource("Hakgyoansim Dunggeunmiso TTF B");
}

.board-slot {
    width: 100%;
    flex-grow: 1;
    flex-shrink: 1;
    justify-content: center;
    align-items: center;
    padding: 1.5% 2.5%;
}

.bottom-rect {
    position: absolute;
    left: -6%;
    right: -6%;
    top: 6%;
    bottom: -2%;
    background-image: url("project://database/Assets/Match%20Defense/Sprites/UI/Clay_Rects.png?fileID=-981860313&guid=d8cd81cc99e6902459f2c392b35ef169&type=3#Clay_Rects_4");
    -unity-background-image-tint-color: rgb(67, 36, 16);
    -unity-slice-left: 10;
    -unity-slice-top: 10;
    -unity-slice-right: 10;
    -unity-slice-bottom: 10;
    transition-property: translate, height;
    transition-duration: 0.5s;
    transition-timing-function: ease-in;
}

.bottom-rect.hide {
    position: absolute;
    bottom: -2%;
    height: 10%;
    width: 112%;
}

.bottom-controls {
    width: 96%;
    height: 17%;
    flex-shrink: 0;
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
}

.match-board {
    position: relative;
    height: 100%;
    width: auto;
    max-width: 100%;
    aspect-ratio: 1.2;
    transition-property: translate;
    transition-duration: 0.5s;
    transition-timing-function: ease-in;
}

.match-board.hide {
    translate: 0 180%;
}

.match-cell {
    border-radius: 15%;
}

.cell-type-a {
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Match%20Defense/Sprites/UI/Clay_Rects.png?fileID=-1111875157&guid=d8cd81cc99e6902459f2c392b35ef169&type=3#Clay_Rects_1");
    -unity-background-image-tint-color: rgb(140, 98, 56);
    -unity-slice-left: 1;
    -unity-slice-top: 1;
    -unity-slice-right: 1;
    -unity-slice-bottom: 1;
}

.cell-type-b {
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Match%20Defense/Sprites/UI/Clay_Rects.png?fileID=496504100&guid=d8cd81cc99e6902459f2c392b35ef169&type=3#Clay_Rects_11");
    -unity-slice-left: 1;
    -unity-slice-top: 1;
    -unity-slice-right: 1;
    -unity-slice-bottom: 1;
    -unity-background-image-tint-color: rgb(125, 77, 40);
}

.match-item {
    background-position: center;
    filter: drop-shadow(0 1 2 rgba(0, 0, 0, 0.561));
}

.unity-toggle__input {
    visibility: hidden;
    display: none;
}

.play-btn {
    aspect-ratio: 1;
    height: 100%;
    width: auto;
    max-width: 100%;
    bottom: 2%;
    position: relative;
    align-self: center;
    align-content: center;
    background-image: url("project://database/Assets/Match%20Defense/Sprites/UI/Clay_Button.png?fileID=1235389772&guid=930688b933a58884b84696eacc44a6a8&type=3#Clay_Button_0");
    transition-timing-function: ease-in-out-sine;
    transition-duration: 0.2s;
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 3.5%;
    padding-right: 3.5%;
    padding-bottom: 3.5%;
    padding-left: 3.5%;
    -unity-background-image-tint-color: rgb(178, 102, 39);
}

.play-btn .unity-image {
    -unity-background-image-tint-color: rgb(241, 229, 221);
    background-image: url("project://database/Assets/Match%20Defense/Sprites/UI/Clay_Button.png?fileID=1358254642&guid=930688b933a58884b84696eacc44a6a8&type=3#Clay_Button_2");
    height: 70%;
    width: 60%;
    align-self: center;
    margin-left: 22%;
    transition-duration: 0.1s;
    transition-timing-function: ease-in;
}

.play-btn:active {
    -unity-background-image-tint-color: rgb(159, 90, 34);
    background-image: url("project://database/Assets/Match%20Defense/Sprites/UI/Clay_Button.png?fileID=-1174686892&guid=930688b933a58884b84696eacc44a6a8&type=3#Clay_Button_1");
}

.play-btn:active .unity-image {
    -unity-background-image-tint-color: rgb(217, 204, 195);
    background-image: url("project://database/Assets/Match%20Defense/Sprites/UI/Clay_Button.png?fileID=210875437&guid=930688b933a58884b84696eacc44a6a8&type=3#Clay_Button_3");
    height: 70%;
    width: 60%;
    align-self: center;
}

.play-btn:checked {
    -unity-background-image-tint-color: rgb(159, 90, 34);
    background-image: url("project://database/Assets/Match%20Defense/Sprites/UI/Clay_Button.png?fileID=-1174686892&guid=930688b933a58884b84696eacc44a6a8&type=3#Clay_Button_1");
    transition-duration: 0.5s;
    transition-timing-function: ease-in-back;
}

.play-btn:checked .unity-image {
    -unity-background-image-tint-color: rgb(217, 204, 195);
    background-image: url("project://database/Assets/Match%20Defense/Sprites/UI/Clay_Button.png?fileID=210875437&guid=930688b933a58884b84696eacc44a6a8&type=3#Clay_Button_3");
    height: 70%;
    width: 60%;
    align-self: center;
}

.play-btn.hide {
    translate: 0 200%;
    background-color: rgba(1, 1, 1, 0);
    border-left-color: rgba(1, 1, 1, 0);
    border-right-color: rgba(1, 1, 1, 0);
    border-top-color: rgba(1, 1, 1, 0);
    border-bottom-color: rgba(1, 1, 1, 0);
}

.side-btn {
    position: relative;
    transition-property: translate;
    transition-duration: 0.5s;
    transition-timing-function: ease-out-back;
    background-image: url("project://database/Assets/Match%20Defense/Sprites/UI/Clay_Rects.png?fileID=-1374895064&guid=d8cd81cc99e6902459f2c392b35ef169&type=3#Clay_Rects_12");
    -unity-background-image-tint-color: rgb(103, 55, 24);
    -unity-slice-left: 7;
    -unity-slice-top: 7;
    -unity-slice-right: 7;
    -unity-slice-bottom: 7;
}

.side-btn .unity-label {
    width: 100%;
    height: 100%;
    -unity-font-definition: resource("Hakgyoansim Dunggeunmiso TTF B");
    -unity-font-style: normal;
    color: rgb(195, 119, 69);
    align-self: center;
    -unity-text-align: middle-center;
    -unity-text-auto-size: best-fit 10px 200px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
}

.turn-count {
    width: 24%;
    height: 90%;
    flex-direction: row;
    justify-content: space-around;
    align-items: center;
    padding: 2% 4%;
}

.turn-icon {
    width: 50%;
    height: auto;
    flex-shrink: 0;
    aspect-ratio: 1;
}

.side-btn .turn-count-label {
    width: 48%;
    height: 75%;
    flex-shrink: 1;
    -unity-text-align: middle-center;
}

.turn-count.hide {
    bottom: 10%;
    width: 32%;
    height: 8%;
}

.double-btn {
    position: absolute;
    width: 100%;
    height: 95%;
    padding-top: 20%;
    padding-bottom: 20%;
    align-self: center;
    background-image: url("project://database/Assets/Match%20Defense/Sprites/UI/Clay_Rects.png?fileID=-981860313&guid=d8cd81cc99e6902459f2c392b35ef169&type=3#Clay_Rects_4");
    bottom: 1.5%;
    letter-spacing: 5px;
    padding-right: 10%;
    padding-left: 10%;
}

.double-btn.hide {
    translate: 0 200%;
}

.double-btn:active {
    -unity-background-image-tint-color: rgb(159, 90, 34);
}

.double-btn .double-off-txt {
    display: flex;
}

.double-btn .double-on-txt {
    display: none;
}

.double-btn:checked .double-off-txt {
    display: none;
}

.double-btn:checked .double-on-txt {
    display: flex;
}

.auto-group {
    width: 14%;
    height: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
}

.auto-txt {
    height: 28%;
    width: 100%;
    margin: 0;
    padding: 0;
    -unity-text-align: lower-center;
    -unity-text-auto-size: best-fit 8px 100px;
    -unity-font-definition: resource("Hakgyoansim Dunggeunmiso TTF B");
    color: rgba(195, 119, 69, 0.58);
}

.auto-btn {
    height: 70%;
    width: auto;
    max-width: 100%;
    aspect-ratio: 1;
    margin: 0;
    padding: 0;
}

.auto-btn:active {
    -unity-background-image-tint-color: rgb(80, 42, 15);
}

.auto-btn .unity-label {
    top: -55%;
    width: 100%;
    height: 50%;
}

.auto-check {
    display: none;
    width: 60%;
    position: absolute;
    align-self: center;
    height: 50%;
    margin-left: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    left: 25%;
}

.auto-btn:checked .auto-check {
    display: flex;
}

.center-btn-slot {
    width: 22%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.items-slot {
    width: 34%;
    height: 90%;
}

.hide {
}

.store-frame--locked {
    opacity: 0.65;
}

.store-lock-overlay {
    background-color: rgba(20, 10, 4, 0.58);
    border-radius: 14px;
}

.store-lock-icon {
    -unity-font-definition: resource("Hakgyoansim Dunggeunmiso TTF B");
    -unity-text-align: middle-center;
    color: rgb(255, 226, 168);
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.7);
}

.top-hud {
    height: 7.4%;
    padding: 1.2% 3% 0.4% 3%;
    align-items: flex-start;
}

.top-right-group {
    width: 44%;
    height: 58%;
    margin-top: 0.4%;
}

.hp-group {
    width: 46%;
    height: 100%;
    flex-direction: row;
    align-items: flex-start;
    position: relative;
}

.hp-bar-bg {
    top: 4%;
    left: 11%;
    right: 0;
    height: 48%;
    padding-top: 0;
    padding-bottom: 0;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-right-radius: 14px;
    border-bottom-left-radius: 14px;
}

.hp-text {
    -unity-text-auto-size: none;
    font-size: 34px;
    padding-left: 16%;
    padding-right: 4%;
}

.hp-bar-fill--hit {
    background-color: rgb(255, 168, 146);
}

.hp-tick {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 3px;
    background-color: rgba(68, 18, 14, 0.78);
    translate: -1.5px 0;
}

.hp-stars-row {
    position: absolute;
    left: 11%;
    right: 0;
    top: 56%;
    height: 34%;
}

.hp-star {
    position: absolute;
    top: 0;
    height: 100%;
    width: auto;
    aspect-ratio: 1;
    translate: -50% 0;
    background-image: url("project://database/Assets/Match%20Defense/Sprites/Lobby/Clay_Star.png?fileID=-1635362499&guid=1d4a53bac73772346b4713bf5106a78c&type=3#Clay_Star_1");
    -unity-background-image-tint-color: rgb(255, 206, 28);
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    transform-origin: center;
    filter: drop-shadow(0 2 3 rgba(0, 0, 0, 0.5));
}

.hp-star--lost {
    -unity-background-image-tint-color: rgb(36, 28, 24);
    opacity: 0.82;
}

.hp-heart {
    top: 0;
    height: 58%;
    transform-origin: center;
}
