<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="ResultPopupStyle.uss" />
    <ui:VisualElement name="result-overlay" class="result-overlay hide">
        <!-- Top-Right Floating Coin Pill (Lobby-identical 3D Clay Style) -->
        <ui:VisualElement name="result-coin-pill" class="result-coin-pill">
            <ui:VisualElement name="result-coin-icon" class="result-coin-badge" picking-mode="Ignore">
                <ui:Label text="C" name="result-coin-icon-txt" class="result-coin-badge-txt" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label text="0" name="result-coin-label" class="result-coin-value" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- Stage Clear Celebration Panel -->
        <ui:VisualElement name="endless-choice-panel" class="result-window result-window--clear">
            <ui:VisualElement name="result-success-image" class="result-success-image" />
            <ui:Label text="STAGE CLEAR!" name="endless-title" class="result-title" />

            <!-- 5 Animated Clay Stars -->
            <ui:VisualElement name="result-stars-row" class="result-stars-row">
                <ui:VisualElement name="result-star-0" class="result-star result-star--empty" />
                <ui:VisualElement name="result-star-1" class="result-star result-star--empty" />
                <ui:VisualElement name="result-star-2" class="result-star result-star--empty" />
                <ui:VisualElement name="result-star-3" class="result-star result-star--empty" />
                <ui:VisualElement name="result-star-4" class="result-star result-star--empty" />
            </ui:VisualElement>

            <!-- Clear Reward + Remaining Turn Drain Box -->
            <ui:VisualElement name="clear-reward-origin" class="result-reward-box">
                <ui:VisualElement class="result-reward-row">
                    <ui:Label text="Clear Reward" name="clear-reward-title" class="result-reward-line" />
                    <ui:Label text="+450" name="clear-reward-amount" class="result-reward-amount" />
                </ui:VisualElement>
                <ui:VisualElement name="result-turn-origin" class="result-turn-row">
                    <ui:Label text="TURN" class="result-turn-tag" />
                    <ui:Label text="5" name="result-turn-count" class="result-turn-count" />
                    <ui:Label text="-> +50" name="result-turn-coin-preview" class="result-turn-bonus" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="result-btn-row">
                <ui:Button text="EXIT" name="endless-stop-btn" class="result-btn result-btn--half result-btn--secondary" />
                <ui:Button text="CONTINUE" name="endless-continue-btn" class="result-btn result-btn--half result-btn--primary" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Defeat / Game Over Panel -->
        <ui:VisualElement name="final-result-panel" class="result-window">
            <ui:Label text="GAME OVER" name="result-title" class="result-title" />
            <ui:Label text="WAVE 1 / 40" name="result-wave-label" class="result-wave-label" />
            <ui:VisualElement class="result-btn-row">
                <ui:Button text="RETRY" name="result-retry-btn" class="result-btn result-btn--half result-btn--primary" />
                <ui:Button text="LOBBY" name="result-lobby-btn" class="result-btn result-btn--half result-btn--secondary" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
