<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="CardRoot" style="flex-grow: 1; width: 200px; height: 200px;">
        <ui:VisualElement name="FillContainer" style="flex-grow: 1; position: absolute; overflow: hidden;">
            <ui:VisualElement name="FillImage" style="flex-grow: 1; position: absolute;"/>
        </ui:VisualElement>
        <ui:Label text="0" name="CountLabel" style="color: rgb(255, 255, 255); font-size: 50px; -unity-font-style: bold; margin-top: 10px; margin-left: 20px; margin-right: 20px; -unity-text-align: upper-right;"/>
    </ui:VisualElement>
</ui:UXML>
