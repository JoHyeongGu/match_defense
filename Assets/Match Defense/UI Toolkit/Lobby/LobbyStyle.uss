:root {
}

.play-btn {
    position: absolute;
    border-top-left-radius: 30%;
    border-top-right-radius: 30%;
    border-bottom-right-radius: 30%;
    border-bottom-left-radius: 30%;
    height: 10%;
    width: 20%;
    align-self: center;
    align-content: center;
    transition-timing-function: ease-in-out-sine;
    transition-duration: 0.5s;
    bottom: 20%;
}

.play-btn.hide {
    bottom: -20%;
    background-color: rgba(1, 1, 1, 0);
    border-left-color: rgba(1, 1, 1, 0);
    border-right-color: rgba(1, 1, 1, 0);
    border-top-color: rgba(1, 1, 1, 0);
    border-bottom-color: rgba(1, 1, 1, 0);
}

.bottom-tabs {
    flex-direction: row;
    margin-top: 0%;
    margin-right: 0%;
    margin-bottom: 0%;
    margin-left: 0%;
    height: 15%;
    position: absolute;
    top: auto;
    width: 100%;
    left: auto;
    bottom: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    align-items: stretch;
}

.page {
    position: absolute;
    width: 100%;
    height: 100%;
    left: 0;
    top: 0;
    translate: 100% 0;
    opacity: 1;
    display: none;
    transition-property: translate, opacity;
    transition-duration: 0.35s;
    transition-timing-function: ease-out-cubic;
}

.page--active {
    translate: 0 0;
    opacity: 1;
}